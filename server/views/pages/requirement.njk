{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "../showErrorSummary.njk" import showErrorSummary %}

{% extends "../partials/layout.njk" %}

{% block content %}
  {{ showErrorSummary(errorSummary) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full cpb-page-header">
      <div>
        {% if person.isLimited %}
          <h1 class="govuk-heading-l">{{ person.crn }}</h1>
        {% else %}
          <span class="govuk-caption-l">Y023782</span>
          <h1 class="govuk-heading-l">{{ person.name }}</h1>
        {% endif %}
      </div>
    </div>
  </div>

  <div>
    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
  </div>

  <form action="{{ updatePath }}" method="post">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <input type="hidden" name="form" value="{{ form }}">

    <div class="govuk-!-margin-top-4">
      {{ govukRadios({
        name: "deliusEventNumber",
        fieldset: {
          legend: {
            text: "Existing requirements",
            classes: "govuk-fieldset__legend--m"
          }
        },
        hint: {
          text: "The correct requirement needs to be selected to ensure the hours can be credited."
        },
        items: unpaidWorkOptions,
        errorMessage: errors.deliusEventNumber
      }) }}
    </div>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">
        <div class="govuk-button-group">
          {{ govukButton({
            text: "Continue"
          }) }}
        </div>
      </div>
    </div>

  </form>
{% endblock %}
