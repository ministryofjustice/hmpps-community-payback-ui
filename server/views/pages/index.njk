{% extends "../partials/layout.njk" %}

{% set pageTitle = "Home" %}
{% set mainClasses = "app-container govuk-body" %}
{% set bodyClasses = "dashboard--index" %}

{% block content %}
  <h1>Record attendance on community payback</h1>

  <ul class="govuk-grid-row card-group">
    {% if findAPersonEnabled %}
      <li class="govuk-grid-column-one-third card-group__item">
        <div class="card card--clickable" data-cy-card-section="find-a-person">
            <h2 class="govuk-heading-s card__heading">
              <a class="govuk-link card__link" href="{{ paths.people.find() }}">Find a person with a community payback requirement</a>
            </h2>
            <div class="govuk-body card__description">
            {% if otherEteEnabled %}
              <p>Search for a person, see details and process appointments for:</p>
              <ul class="govuk-list govuk-list--bullet">
                <li>group, host partner or induction sessions</li>
                <li>education, training and employment (ETE) outside of Community Campus</li>
              </ul>
            {% else %}
              <p>Search for a person, see details and process appointments for group, host partner or induction sessions.</p>
            {% endif %}
            {% if adjustmentsEnabled %}
              <p>Or make adjustments to their requirement.</p>
            {% endif %}
            </div>

        </div>
      </li>
    {% endif %}
    <li class="govuk-grid-column-one-third card-group__item">
      <div class="card card--clickable" data-cy-card-section="track-progress-group-placements">

          <h2 class="govuk-heading-s card__heading">
            <a class="govuk-link card__link" href="{{ paths.sessions.index() }}">Record attendance at a group session or induction</a>
          </h2>
          <p class="govuk-body card__description">Find sessions and record people's attendance and compliance</p>

      </div>
    </li>
    <li class="govuk-grid-column-one-third card-group__item">
      <div class="card card--clickable" data-cy-card-section="track-progress-individual-placements">
          <h2 class="govuk-heading-s card__heading">
            <a class="govuk-link card__link" href="{{ paths.projects.index() }}">Record attendance at a host partner</a>
          </h2>
          <p class="govuk-body card__description">Find placements and record people's attendance and compliance</p>
      </div>
    </li>
    {% if courseCompletionsEnabled %}
      <li class="govuk-grid-column-one-third card-group__item">
        <div class="card card--clickable" data-cy-card-section="process-course-completions">
            <h2 class="govuk-heading-s card__heading">
              <a class="govuk-link card__link" href="{{ paths.courseCompletions.index() }}">Process Community Campus hours</a>
            </h2>
            <p class="govuk-body card__description">Find people's completed courses and process their hours</p>
        </div>
      </li>
    {% endif %}
    {% if travelTimeEnabled %}
      <li class="govuk-grid-column-one-third card-group__item">
        <div class="card card--clickable" data-cy-card-section="adjust-travel-time">
            <h2 class="govuk-heading-s card__heading">
              <a class="govuk-link card__link" href="{{ paths.appointments.travelTime.index() }}">Record travel time</a>
            </h2>
            <p class="govuk-body card__description">Find people's appointments and record approved travel time</p>
        </div>
      </li>
    {% endif %}
  </ul>

{% endblock %}
