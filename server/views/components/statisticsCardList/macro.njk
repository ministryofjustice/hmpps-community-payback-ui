{% macro statisticsCardList(items) %}

    <ul class="govuk-grid-row card-group">
      {% for item in items %}
        <li class="govuk-grid-column-one-third card-group__item ">
            <div class="govuk-summary-card card govuk-!-padding-0">
              <div class="govuk-summary-card__title-wrapper">
                <h2 class="govuk-summary-card__title">{{ item.key }}</h2>
              </div>
              <div class="govuk-summary-card__content">
                {% if item.description %}
                  <p>
                    <span class="govuk-heading-l govuk-!-margin-bottom-3">{{ item.value }}</span>
                    <span class="govuk-caption-m">{{ item.description }}</span>
                  </p>
                {% else %}
                  <p class="govuk-heading-l">{{ item.value }}</p>
                {% endif %}
              </div>
            </div>
        </li>
      {% endfor %}
    </ul>
{% endmacro %}
