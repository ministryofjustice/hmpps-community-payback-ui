{% from "govuk/components/table/macro.njk" import govukTable %}

<div class="cpb-scrollable-table" role="region" aria-label="Session list" tabindex="0">
  {{ govukTable({
    classes: "govuk-table--small-text-until-tablet",
    head: [
      {
        text: "Name"
      },
      {
        text: "Time"
      },
      {
        text: "Remaining hours"
      },
      {
        text: "Attendance"
      },
      {
        text: "Action"
      }
    ],
    rows: sessionList
  }) }}
</div>
