{% extends "../partials/formLayout.njk" %}

{% from "govuk/components/file-upload/macro.njk" import govukFileUpload %}
{% from "govuk/components/error-message/macro.njk" import govukErrorMessage %}
{% from "../showErrorSummary.njk" import showErrorSummary %}

{% set pageTitle = 'Upload file' %}
{% set formButtonText = "Submit" %}
{% set formEnctype = "multipart/form-data" %}

{% block formHeader %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h2 class="govuk-label-wrapper">
        <label class="govuk-label govuk-label--m" for="file">{{ pageTitle }}</label>
      </h2>
    </div>
  </div>
{% endblock %}

{% block formContent %}
  <div data-module="cpb-file-size-limit" data-max-file-size-bytes="{{ fileSizeLimit.maxBytes }}">
    {{ govukFileUpload({
      id: "file",
      name: "file",
      javascript: true,
      attributes: {
        accept: accept
      },
      errorMessage: errors.file
    }) }}

    <template id="file-size-limit-error-summary">
      {{ showErrorSummary(fileSizeLimit.errorSummary) }}
    </template>
    <template id="file-size-limit-error-message">
      {{ govukErrorMessage({ id: "file-error", text: fileSizeLimit.errorMessage.text }) }}
    </template>
  </div>
{% endblock %}
